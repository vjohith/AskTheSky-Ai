rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Community Reports (LetThemKnow) - Public read, authenticated or guest create, rate-limited
    match /communityReports/{reportId} {
      allow read: if true;
      allow create: if request.resource.data.title is string &&
                      request.resource.data.location is string &&
                      request.resource.data.suggestion is string;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes']);
      allow delete: if false;
    }

    // SOS Emergency Alerts - Public read for relief teams, anyone can broadcast emergency
    match /sosAlerts/{alertId} {
      allow read: if true;
      allow create: if request.resource.data.location is string;
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // User Accounts
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // User Stored Vault Files Metadata
    match /vaultFiles/{fileId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
